  "mapping": "# Risk Radar dataset mapping (D81). Reviewed 17 Sep 2026. The v2 table carries\n# engineered columns and no time or accounts, so it was joined to the clean file\n# by transaction_id (ml/datasets/join_v2_features.py; labels agree on every row).\n# Raw fields come from the clean file, mapped as there. The v2 columns are the\n# comparison arm's native features, except scores and risk flags (D10f). The v2\n# columns checked by eye are point-in-time (a customer's first row has counts of\n# 0 and gaps of -1), so they do not read the future.\ndataset: Nigerian transactions v2 (1M rows, engineered features)\nreviewed: true\nfields:\n  label:\n    column: is_fraud\n    positive:\n    - true\n  fraud_type:\n    column: fraud_type\n  incident:\n    derive:\n      by: customer\n      gap_hours: 24\n  timestamp:\n    column: timestamp\n    timezone: Africa/Lagos\n  amount:\n    column: amount_ngn\n    scale: 100\n  account:\n    column: sender_account\n  beneficiary:\n    column: receiver_account\n  device:\n    column: device_hash\n  channel:\n    column: payment_channel\n    values:\n      USSD: USSD\n      Bank Transfer: API\n      Mobile App: MOBILE_APP\n      Card: POS\n    default: API\n  auth_result:\n    constant: APPROVED\n  instrument:\n    column: transaction_type\n    values:\n      deposit: ACCOUNT_TRANSFER\n      payment: ACCOUNT_TRANSFER\n      withdrawal: CASH\n      transfer: ACCOUNT_TRANSFER\n    default: ACCOUNT_TRANSFER\n  direction:\n    column: transaction_type\n    values:\n      deposit: INBOUND\n      payment: OUTBOUND\n      withdrawal: OUTBOUND\n      transfer: OUTBOUND\n    default: OUTBOUND\n  region:\n    column: state\n  merchant_category:\n    column: merchant_category\nnative_features:\n- v2_is_amount_unusual\n- v2_txn_count_last_1h\n- v2_txn_count_last_24h\n- v2_total_amount_last_1h\n- v2_time_since_last\n- v2_avg_gap_between_txns\n- v2_user_txn_count_total\n- v2_user_avg_txn_amt\n- v2_user_std_txn_amt\n- v2_user_txn_frequency_24h\n- v2_txn_hour\n- v2_is_weekend\n- v2_is_salary_week\n- v2_is_night_txn\n- v2_device_seen_count\n- v2_is_device_shared\nignore:\n  spending_deviation_score: 'somebody else''s score or flag (D10f): never an input'\n  velocity_score: 'somebody else''s score or flag (D10f): never an input'\n  geo_anomaly_score: 'somebody else''s score or flag (D10f): never an input'\n  geospatial_velocity_anomaly: 'somebody else''s score or flag (D10f): never an input'\n  merchant_fraud_rate: 'somebody else''s score or flag (D10f): never an input'\n  channel_risk_score: 'somebody else''s score or flag (D10f): never an input'\n  persona_fraud_risk: 'somebody else''s score or flag (D10f): never an input'\n  location_fraud_risk: 'somebody else''s score or flag (D10f): never an input'\n  is_high_risk_state: 'somebody else''s risk flag (D10f): never an input'\n  is_high_risk_lga: 'somebody else''s risk flag (D10f): never an input'\n  is_ato_risk: 'somebody else''s risk flag (D10f): never an input'\n  source: provenance (real or synthetic), not a transaction fact\n  v2_spending_deviation_score: 'somebody else''s score or risk flag (D10f): never an input'\n  v2_velocity_score: 'somebody else''s score or risk flag (D10f): never an input'\n  v2_geo_anomaly_score: 'somebody else''s score or risk flag (D10f): never an input'\n  v2_geospatial_velocity_anomaly: 'somebody else''s score or risk flag (D10f): never an input'\n  v2_is_ato_risk: 'somebody else''s score or risk flag (D10f): never an input'\n  v2_is_high_risk_state: 'somebody else''s score or risk flag (D10f): never an input'\n  v2_is_high_risk_lga: 'somebody else''s score or risk flag (D10f): never an input'\n",
