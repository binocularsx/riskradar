  "mapping": "# Risk Radar dataset mapping (D81). Reviewed 17 Sep 2026 by hand from the\n# ElectricSheep mapping: the clean file is that dataset plus 86,000 synthetic\n# rows and state, LGA and risk-flag columns. Region is the state (37 values)\n# rather than the city. Risk flags and every *_score/*_risk column are ignored\n# (D10f). Native features are only those computable from the row and its past.\ndataset: Nigerian transactions (clean, 5.09M rows)\nreviewed: true\nfields:\n  label:\n    column: is_fraud\n    positive:\n    - true\n  fraud_type:\n    column: fraud_type\n  incident:\n    derive:\n      by: customer\n      gap_hours: 24\n  timestamp:\n    column: timestamp\n    timezone: Africa/Lagos\n  amount:\n    column: amount_ngn\n    scale: 100\n  account:\n    column: sender_account\n  beneficiary:\n    column: receiver_account\n  device:\n    column: device_hash\n  channel:\n    column: payment_channel\n    values:\n      USSD: USSD\n      Bank Transfer: API\n      Mobile App: MOBILE_APP\n      Card: POS\n    default: API\n  auth_result:\n    constant: APPROVED\n  instrument:\n    column: transaction_type\n    values:\n      deposit: ACCOUNT_TRANSFER\n      payment: ACCOUNT_TRANSFER\n      withdrawal: CASH\n      transfer: ACCOUNT_TRANSFER\n    default: ACCOUNT_TRANSFER\n  direction:\n    column: transaction_type\n    values:\n      deposit: INBOUND\n      payment: OUTBOUND\n      withdrawal: OUTBOUND\n      transfer: OUTBOUND\n    default: OUTBOUND\n  region:\n    column: state\n  merchant_category:\n    column: merchant_category\nnative_features:\n- txn_hour\n- is_weekend\n- is_salary_week\n- is_night_txn\n- txn_count_last_1h\n- txn_count_last_24h\n- total_amount_last_1h\n- time_since_last\nignore:\n  spending_deviation_score: 'somebody else''s score or flag (D10f): never an input'\n  velocity_score: 'somebody else''s score or flag (D10f): never an input'\n  geo_anomaly_score: 'somebody else''s score or flag (D10f): never an input'\n  geospatial_velocity