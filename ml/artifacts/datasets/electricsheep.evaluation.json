  "mapping": "# Risk Radar dataset mapping (D81). Written by `evaluate_dataset.py suggest`.\n# Read every field before running: a wrong sender or label column makes every\n# figure meaningless while looking plausible. Then set `reviewed: true`.\n# NOTE: no incident column: fraud rows of one customer (and type) within 24 hours count as one incident\n# NOTE: amounts are multiplied by 100 into minor units (kobo, cents); set `scale: 1` if already minor\n# NOTE: no approval/decline column: every row is treated as approved, so decline-based measurements and the card-testing rule cannot fire\n# NOTE: `transaction_type` values read as credits: ['deposit']\n# NOTE: 17 other numeric columns are offered as `native_features` for the comparison arm only; delete any that are derived from the label or from the future\ndataset: ElectricSheep Nigerian transactions\nreviewed: true\nfields:\n  label:\n    column: is_fraud\n    positive:\n    - true\n  fraud_type:\n    column: fraud_type\n  incident:\n    derive:\n      by: customer\n      gap_hours: 24\n  timestamp:\n    column: timestamp\n    timezone: Africa/Lagos\n  amount:\n    column: amount_ngn\n    scale: 100\n  account:\n    column: sender_account\n  beneficiary:\n    column: receiver_account\n  device:\n    column: device_hash\n  channel:\n    column: payment_channel\n    values:\n      USSD: USSD\n      Bank Transfer: API\n      Mobile App: MOBILE_APP\n      Card: POS\n    default: API\n  auth_result:\n    constant: APPROVED\n  instrument:\n    column: transaction_type\n    values:\n      deposit: ACCOUNT_TRANSFER\n      payment: ACCOUNT_TRANSFER\n      withdrawal: CASH\n      transfer: ACCOUNT_TRANSFER\n    default: ACCOUNT_TRANSFER\n  direction:\n    column: transaction_type\n    values:\n      deposit: INBOUND\n      payment: OUTBOUND\n      withdrawal: OUTBOUND\n      transfer: OUTBOUND\n    default: OUTBOUND\n  region:\n    column: location\n  merchant_category:\n    column: merchant_category\nnative_features:\n# Reviewed 17 Sep 2026: kept only columns computable from the row and its past.\n# Dropped user_txn_count_total, user_avg_txn_amt, user_std_txn_amt, device_seen_count,\n# ip_seen_count, is_device_shared, is_ip_shared, avg_gap_between_txns (whole-file\n# aggregates: they read the future) and time_since_last_transaction (negative, unexplained).\n- txn_hour\n- is_weekend\n- is_salary_week\n- is_night_txn\n- txn_count_last_1h\n- txn_count_last_24h\n- total_amount_last_1h\n- time_since_last\nignore:\n  spending_deviation_score: 'somebody else''s score or flag (D10f): never an input'\n  velocity_score: 'somebody else''s score or flag (D10f): never an input'\n  geo_anomaly_score: 'somebody else''s score or flag (D10f): never an input'\n  geospatial_velocity_anomaly: 'somebody else''s score or flag (D10f): never an input'\n  merchant_fraud_rate: 'somebody else''s score or flag (D10f): never an input'\n  channel_risk_score: 'somebody else''s score or flag (D10f): never an input'\n  persona_fraud_risk: 'somebody else''s score or flag (D10f): never an input'\n  location_fraud_risk: 'somebody else''s score or flag (D10f): never an input'\n",
