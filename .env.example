# Risk Radar — copy to .env and fill in. NFR-005: no secret in source control.
RISKRADAR_DB_HOST=127.0.0.1
RISKRADAR_DB_PORT=55432
RISKRADAR_DB_NAME=riskradar
RISKRADAR_DB_APP_USER=riskradar_app
RISKRADAR_DB_APP_PASSWORD=change-me
RISKRADAR_DB_MIGRATE_USER=riskradar_migrate
RISKRADAR_DB_MIGRATE_PASSWORD=change-me

# D9c: the HMAC pepper. Tokenisation is one-way; losing this does not expose
# anything, but changing it breaks every existing behavioural baseline.
RISKRADAR_HMAC_PEPPER=change-me-to-a-long-random-string

RISKRADAR_SESSION_COOKIE=rr_session

# D75: identity and the industry watch-list. Each outside system is an adapter;
# the real ones wait (visibly) until their connection is configured.
#   core resolver:     fixture (simulated core file) | none | finacle
#   identity registry: format (shape check only)     | nibss
#   industry connector: none | loopback (accepts, shares nothing) | nibss
#   restriction connector (D97): none | loopback (accepts, shares nothing) | core
RISKRADAR_CORE_RESOLVER=fixture
RISKRADAR_IDENTITY_REGISTRY=format
RISKRADAR_INDUSTRY_CONNECTOR=none
RISKRADAR_RESTRICTION_CONNECTOR=none
#   support-team connector (D109; was the account manager, D106): none | loopback
#   (accepts, notifies nobody) | email (SMTP to one inbox). Reports, urgent
#   heads-ups and contact requests for the support team go through it. `email`
#   sends nothing until both RISKRADAR_SMTP_HOST and RISKRADAR_SUPPORT_EMAIL are
#   set; until then messages wait in the outbox rather than failing. The old
#   RISKRADAR_ACCOUNT_MANAGER_* names are still read.
RISKRADAR_SUPPORT_CONNECTOR=none
RISKRADAR_SUPPORT_EMAIL=
RISKRADAR_SMTP_HOST=
RISKRADAR_SMTP_PORT=587
RISKRADAR_SMTP_FROM=
RISKRADAR_SMTP_USER=
RISKRADAR_SMTP_PASSWORD=
#   STARTTLS is on unless this is exactly "0". Turn it off only for a relay on
#   the same host; a password over a plaintext SMTP session is a password given away.
RISKRADAR_SMTP_STARTTLS=1
RISKRADAR_INSTITUTION_CODE=RISKRADAR-DEV
# RISKRADAR_FINACLE_URL=
# RISKRADAR_NIBSS_BVN_URL=
# RISKRADAR_NIBSS_WATCHLIST_URL=
# RISKRADAR_RESTRICTION_URL=
RISKRADAR_ENV=development

# --- serving (D87) -----------------------------------------------------------
# development | production. Production turns on secure cookies, HSTS and JSON
# logs, and readiness fails while the seeded development API key is active.
# RISKRADAR_ENV=production
# The console's origins, comma separated. Required in production only if the
# console is served from a DIFFERENT origin than the API. The live deployment
# (D101b) serves both from one origin behind Caddy, so leave this EMPTY there.
# RISKRADAR_CORS_ORIGINS=https://riskradar.bank.example
#
# --- live cloud deployment (D101) --------------------------------------------
# The public address Caddy serves and gets HTTPS for. A domain enables automatic
# TLS; ":80" or "localhost" serves plain HTTP for a local trial. Only used by
# deploy/docker-compose.prod.yml.
# RISKRADAR_SITE_ADDRESS=riskradar.example.com
# RISKRADAR_ACME_EMAIL=you@example.com
RISKRADAR_API_HOST=127.0.0.1
RISKRADAR_API_PORT=8000
# Three API processes and four scoring workers held 50 TPS at p95 210 ms and a
# 231 TPS burst on an 8-core machine (D87a).
RISKRADAR_API_WORKERS=3
# Payments a worker leases at once; small keeps latency low (D87a).
RISKRADAR_WORKER_BATCH=8
RISKRADAR_DB_POOL_MIN=2
RISKRADAR_DB_POOL_MAX=24
# Per API key, per API process: transactions a second and the burst allowed.
RISKRADAR_INGEST_RATE=300
RISKRADAR_INGEST_BURST=1500
RISKRADAR_REPLAY_RATE=2000
RISKRADAR_REPLAY_BURST=5000
# Live payments waiting to be scored: slow-down header above SOFT, 503 above HARD.
RISKRADAR_QUEUE_SOFT_LIMIT=2000
RISKRADAR_QUEUE_HARD_LIMIT=20000
RISKRADAR_REPLAY_QUEUE_LIMIT=50000
RISKRADAR_WORKER_STALE_SECONDS=60
# How far ahead of the server's clock an event may be dated.
RISKRADAR_MAX_CLOCK_SKEW_SECONDS=300
# RISKRADAR_LOG_JSON=true
# Used only by scripts/migrate.py to create the roles and database.
# RISKRADAR_PG_SUPERUSER=postgres
# RISKRADAR_PG_SUPERUSER_PASSWORD=
